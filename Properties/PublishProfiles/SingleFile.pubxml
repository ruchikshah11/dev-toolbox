<Project>
  <!--
    Produces the same "hand it out as one portable exe, no loose DLLs" distributable that
    Costura.Fody used to give on .NET Framework, using modern .NET's own single-file publish
    instead. Deliberately kept out of the main csproj's PropertyGroup - a RuntimeIdentifier there
    would also change every ordinary `dotnet build`/F5-debug output path and layout, which isn't
    wanted for day-to-day development. Use via:

      dotnet publish -c Release -p:PublishProfile=SingleFile

    or by selecting this profile from Visual Studio's Publish dialog.
  -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\Publish\</PublishDir>
  </PropertyGroup>
</Project>
