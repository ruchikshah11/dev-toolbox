<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="System.Windows.Forms.ApplicationConfigurationSection"
             type="System.Windows.Forms.ApplicationConfigurationSection, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!-- Without this, the app isn't DPI-aware at all, so Windows bitmap-stretches the whole UI on
       any scaled display - small text (like button labels) gets blurry enough to misread, which
       is what was happening to the Copy buttons ("Copy" looking like "Conv").
       System (not PerMonitorV2) on purpose: the HTML Viewer/Markdown Previewer previews use the
       legacy WebBrowser control (WebView2 was tried and reverted - its native loader DLL
       couldn't be made to travel inside the single portable exe), which isn't itself per-monitor
       DPI aware, so under PerMonitorV2 it lays out content assuming more physical width than its
       WinForms container actually gets on screen - text runs past the visible edge with no
       scrollbar to reach it. Plain System DPI awareness still renders the rest of the UI crisp at
       the monitor's scale, without the per-monitor rescale events that desync the WebBrowser
       control - the previews may still cut off wide content occasionally as a known limitation. -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="System" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
